        "start": "node dist/index.js",
        "start:dev": "tsx src/index.ts",
        "lint": "effect-tsgo oxlint --type-aware src/ && eslint src/"
    },
    "keywords": [
        "ruuvitag",
        "iot",
        "bluetooth",
        "ble",
        "low",
        "energy",
        "miflora",
        "mqtt",
        "homeassistant"
    ],
    "author": "Juuso Leinonen",
    "license": "MIT",
    "dependencies": {
        "@effect/platform-node": "0.108.4",
        "@stoprocent/noble": "2.8.0",
        "dotenv": "18.0.9",
        "effect": "3.22.4",
        "js-yaml": "5.5.0",
        "lodash": "4.18.1",
        "lodash.snakecase": "4.1.1",
        "luxon": "3.7.2",
        "mqtt": "5.16.1",
        "uuid": "14.0.3",
        "winston": "3.19.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@effect/tsgo": "0.67.5",
        "@eslint/js": "10.0.1",
        "@types/js-yaml": "4.0.9",
