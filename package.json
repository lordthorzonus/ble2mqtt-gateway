        "@types/lodash.snakecase": "4.1.9",
        "@types/luxon": "3.7.6",
        "@types/noble": "0.0.44",
        "@types/node": "22.20.5",
        "@types/ws": "8.18.2",
        "@typescript/native": "npm:typescript@7.0.2",
        "@vitest/coverage-v8": "5.1.0",
        "@vitest/eslint-plugin": "1.6.28",
        "eslint": "10.14.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-oxlint": "1.92.0",
        "eslint-plugin-prettier": "5.5.7",
        "oxlint": "1.92.0",
        "oxlint-tsgolint": "7.0.2006",
        "prettier": "3.9.10",
        "tsx": "4.23.15",
        "typescript": "npm:@typescript/typescript6@6.0.2",
