{
    "name": "ble2mqtt-gateway",
    "description": "BLE to MQTT Gateway",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "test": "vitest run",
        "dev": "tsx src/dev.ts",
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "start": "node dist/index.js",
        "start:dev": "tsx src/index.ts",
        "lint": "effect-tsgo oxlint --type-aware --deny-warnings src/ && oxfmt --check src/",
        "format": "oxfmt src/"
    },
    "keywords": [
        "ruuvitag",
        "iot",
        "bluetooth",
        "ble",
        "low",
        "energy",
        "miflora",
        "mqtt",
        "homeassistant"
    ],
    "author": "Juuso Leinonen",
    "license": "MIT",
    "dependencies": {
        "@effect/platform-node": "4.1.4",
        "@stoprocent/noble": "2.8.0",
        "dotenv": "18.0.10",
        "effect": "4.1.4",
        "js-yaml": "5.5.0",
        "lodash": "4.18.1",
        "lodash.snakecase": "4.1.1",
        "luxon": "3.7.2",
        "mqtt": "5.16.1",
        "uuid": "14.0.3",
        "winston": "3.19.0",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@effect/tsgo": "0.67.7",
        "@oxlint/plugins": "1.93.0",
        "@types/js-yaml": "4.0.9",
        "@types/lodash": "4.17.27",
        "@types/lodash.snakecase": "4.1.9",
        "@types/luxon": "3.7.6",
        "@types/noble": "0.0.44",
        "@types/node": "22.20.5",
        "@types/ws": "8.18.2",
        "@vitest/coverage-v8": "5.1.0",
        "fast-check": "4.10.2",
        "oxfmt": "0.78.0",
        "oxlint": "1.93.0",
        "oxlint-tsgolint": "7.0.2006",
        "tsx": "4.23.15",
        "typescript": "7.0.2",
        "vitest": "5.1.0"
    }
}
