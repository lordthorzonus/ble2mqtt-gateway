{
    "name": "ble2mqtt-gateway",
    "description": "BLE to MQTT Gateway",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "test": "vitest run",
        "dev": "tsx src/dev.ts",
        "build": "tsc -p tsconfig.json",
