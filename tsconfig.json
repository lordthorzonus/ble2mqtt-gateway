{
    "compilerOptions": {
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "target": "ES2023",
        "lib": [
            "ES2023"
        ],
        "types": [
            "node"
        ],
        "strict": true,
        "sourceMap": true,
        "rootDir": "src",
        "outDir": "dist",
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "skipLibCheck": true,
        "plugins": [
            {
                "name": "@effect/language-service"
            }
        ]
    },
    "exclude": [
        "dist",
        "node_modules"
    ],
    "include": [
        "src/**/*.ts",
        "src/**/*.d.ts"
    ]
}
